# ============================================
# Freelance Pro - Fichiers ignores par Git
# ============================================

# --- Environnement & Secrets ---
.env
.env.local
.env.*.local
.env.backup
.env.production
!.env.example

# Backend (deja gere par le .gitignore du backend)
backend/.env
backend/.env.local
backend/.env.*.local
backend/.env.backup
!backend/.env.example

# --- IDE & Editeurs ---
/.idea
/.vscode
/.cursor/
/.nova
/.zed
.phpactor.json
_ide_helper.php

# --- OS ---
.DS_Store
Thumbs.db

# --- Dependances ---
/vendor
/node_modules
/backend/vendor
/frontend/node_modules
/auth.json

# --- Laravel / Build ---
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
Homestead.json
Homestead.yaml

# --- Tests & Cache ---
.phpunit.result.cache
/.phpunit.cache

# --- Docker ---
docker-compose.override.yml

# --- Terraform (a ajouter plus tard) ---
*.tfstate
*.tfstate.*
.terraform/
terraform.tfvars